<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <io.smileyjoe.library.recycler.RecyclerViewQuickScroll
        android:id="@+id/recycler_app_details"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="@dimen/padding_small"
        android:visibility="gone"
        app:layout_alphabetLayout="@id/layout_alphabet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <io.smileyjoe.library.recycler.AlphabetLayout
        android:id="@+id/layout_alphabet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/padding_small"
        android:background="@drawable/bg_pill"
        android:elevation="@dimen/elevation_quick_scroll"
        android:orientation="vertical"
        android:paddingTop="@dimen/padding_medium"
        android:paddingBottom="@dimen/padding_medium"
        app:item_paddingEnd="@dimen/padding_medium"
        app:item_paddingStart="@dimen/padding_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:view_header="@id/text_section" />

    <TextView
        android:id="@+id/text_section"
        style="@style/Text.Heading.Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/padding_small"
        android:background="@drawable/bg_circle"
        android:backgroundTint="?attr/colorSurfaceContainerHigh"
        android:elevation="@dimen/elevation_quick_scroll"
        android:padding="@dimen/padding_medium"
        android:textAlignment="center"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintEnd_toStartOf="@id/layout_alphabet"
        app:layout_constraintTop_toTopOf="@id/layout_alphabet" />

</androidx.constraintlayout.widget.ConstraintLayout>
